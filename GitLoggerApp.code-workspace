        /*

        */
        "chat.tools.terminal.enableAutoApprove": true, /* ex: <https://r-vm.com/automating-my-git-workflow-vscode-copilot-chat-terminal-auto-approval.html> */
        /* #region auto approval urls */
        "chat.tools.urls.autoApprove": {
            "http://127.0.0.1:3001/*": true, // the default GitServe API hostname
            "http://127.0.0.1:3000/*": true, // the default GitLoggerApp hostname
            "https://code.visualstudio.com": true,
            "https://github.com/microsoft/vscode/wiki/*": true
        },
        /*

        #regionend auto approval urls

        */
        // "chat.autopilot.advanced.enabled": false,
        "chat.tools.terminal.autoApprove": {
            /* #region terminal allow list */
            "/^Set-Location .*$/": {
                /* warning: this only ensures this command is the first in an expression. Not whether the rest is safe, or, even executions this command */
                "approve": true,
                "matchCommandLine": true
            },
            /* #regionend terminal allow list */
            /* #region terminal deny list */
            "/^(rm|rmdir|del|kill|curl|wget|eval|chmod|chown|Remove-Item)\\s+/": {
                "approve": false,
                "matchCommandLine": true
            },
            /* #regionend terminal deny list */
        },
