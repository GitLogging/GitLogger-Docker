    "settings": {
        /* #region code formatting */
        "[typescript][typescriptreact][javascript][javascriptreact]": {
            "editor.fontSize": 16,
            "editor.formatOnSave": true,
            "editor.formatOnSaveMode": "modificationsIfAvailable"
        },
        /*

        #regionend code formatting */
        /* #region llm permissions

        about: started 2026-08-02. Testing optional inclusion/exclusion lists

        [tip!]: you can type a partial name like "chat" then "<ctrl+Spacebar> to **fuzzy find** these settings without knowing the exact names

        more settings to disable: ( using glob syntax. '.' means a literal '.' )

            *.agent.*.enable
            *agentHost*
            *.copilot.*.enable
            chat.*.enable
            chat.*.mcp


        specific names:

            chat.agent.networkFilter
            chat.agentHost.agentDebugLog.enabled

        */

        "chat.disableAIFeatures": false,
        // "chat.tools.edits.autoApprove": {
            // #region auto approval filepaths
                // "**/*": true,
            // #regionend auto approval filepaths

            // #region auto deny filepaths
